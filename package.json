{
  "name": "qa-dashboard-tool",
  "version": "1.22.0",
  "private": true,
  "description": "Local dashboard to log QA tests (daily, Smoke, Regression) with Jira tickets",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,client \"tsx watch src/server/index.ts\" \"vite\"",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "npm run build && node dist/server/index.js --open",
    "serve": "node dist/server/index.js --open",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "desktop": "npm run build && env -u ELECTRON_RUN_AS_NODE electron .",
    "desktop:pack": "npm run build && electron-builder --mac --dir",
    "desktop:dist": "npm run build && electron-builder --mac dmg zip --arm64 --x64 --publish never",
    "demo": "npm run build && node dist/server/index.js --demo --open",
    "demo:en": "npm run build && node dist/server/index.js --demo --lang en --open"
  },
  "dependencies": {
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "concurrently": "^10.0.7",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "jsdom": "^31.0.1",
    "oxlint": "1.93.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "main": "dist/desktop/main.js",
  "build": {
    "appId": "local.qadashboard",
    "productName": "QA Dashboard",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "build/icon.png",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": "dir",
      "identity": null,
      "icon": "build/icon.png",
      "artifactName": "QA-Dashboard-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "QA Dashboard ${version}"
    }
  }
}
